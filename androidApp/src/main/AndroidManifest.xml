<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Сохранение вложений чата в общие «Загрузки» на Android 7–9; с API 29 — MediaStore без разрешения. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Поиск и подключение устройств Pandora по BLE (feature/device) -->
    <!-- до Android 12 BLE-скан требует геолокации -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Android 12+ : сканирование не используется для определения местоположения -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- BLE-железо: required=false, чтобы приложение ставилось и на устройства без BLE
         (SDK объявляет его обязательным — перекрываем через tools:node=replace). -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false"
        tools:node="replace" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- Подключение устройств по USB (host-режим) -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="SpeCMP"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".AppActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Открытие вложений чата во внешних приложениях (ACTION_VIEW + URI-грант). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.supportchat.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/support_chat_file_paths" />
        </provider>
    </application>

</manifest>
