# Креды тестовых аккаунтов для UI-тестов SpeCMP.
# Скопируй в credentials.properties рядом (.agents/skills/ui-test/) и заполни: файл в .gitignore.
# Ключи доступны в Maestro-флоу как ${KEY}, агент читает файл напрямую.
# Значения — только латиница/цифры/ASCII: adb input не вводит кириллицу.

# Основной аккаунт специалиста: активирован, без блокировок.
QA_EMAIL=
QA_PASSWORD=

# Свободный email-шаблон для регистрации: {n} ui.sh заменяет на timestamp.
QA_REGISTER_EMAIL=qa+{n}@example.com
QA_REGISTER_PASSWORD=
QA_REGISTER_NAME=QA Tester
QA_REGISTER_PHONE=
