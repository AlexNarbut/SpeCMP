{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/agent-hooks/kotlin-quality.sh --format codex",
            "timeout": 180,
            "statusMessage": "kotlin-quality"
          }
        ]
      }
    ]
  }
}
