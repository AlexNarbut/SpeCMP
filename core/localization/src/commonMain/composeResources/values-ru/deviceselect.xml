    <string-array name="deviceselect_fix_item_android">
        <item>Настройки → Приложения → Pandora Spec → Разрешения</item>
        <item>Включите «Устройства поблизости» и «Bluetooth»</item>
    </string-array>
    <string-array name="deviceselect_fix_item_ios">
        <item>Настройки → Pandora Spec → Bluetooth → включить</item>
    </string-array>
    <string name="deviceselect_common_btn_open_settings">Открыть настройки</string>
