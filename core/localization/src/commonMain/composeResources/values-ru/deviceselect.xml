    <string name="deviceselect_scanning_title">Поиск устройств…</string>
    <string name="deviceselect_scanning_subtitle_ble">Держите устройство Pandora рядом. Bluetooth-устройства появятся в списке автоматически.</string>
    <string name="deviceselect_scanning_subtitle_usb">Подключите устройство Pandora кабелем. USB-устройства появятся в списке автоматически.</string>
    <string name="deviceselect_scanning_subtitle_both">Держите устройство Pandora рядом. Bluetooth- и USB-устройства появятся в списке автоматически.</string>

    <!-- Пусто -->
    <string name="deviceselect_empty_title">Устройства не найдены</string>
    <string name="deviceselect_empty_subtitle">Поиск продолжается. Проверьте, что устройство готово к подключению.</string>
    <!-- Подсказки «пусто» — по поддерживаемым транспортам -->
    <string-array name="deviceselect_empty_item_ble">
        <item>Убедитесь, что на устройстве включено питание</item>
        <item>Поднесите блок ближе — в пределах 1–2 метров</item>
        <item>Проверьте, что Bluetooth включён</item>
    </string-array>
    <string-array name="deviceselect_empty_item_usb">
        <item>Проверьте, что кабель подключён к устройству и компьютеру</item>
        <item>Попробуйте другой USB-порт или кабель</item>
        <item>Убедитесь, что модуль определяется системой</item>
    </string-array>
    <string-array name="deviceselect_empty_item_both">
        <item>Убедитесь, что устройство включено, а кабель подключён</item>
        <item>Для Bluetooth поднесите блок ближе — в пределах 1–2 метров</item>
        <item>Проверьте, что включён Bluetooth или USB-модуль определяется</item>
    </string-array>
