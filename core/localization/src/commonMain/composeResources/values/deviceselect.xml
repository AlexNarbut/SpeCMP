    <string name="deviceselect_common_a11y_device_photo">device photo</string>

    <!-- Permission rationale -->

    <!-- Denied -->
    <string name="deviceselect_denied_title">No access</string>
    <string name="deviceselect_denied_subtitle">Without permission the app can't find devices. Enable access in settings.</string>
    <string-array name="deviceselect_fix_item_android">
        <item>Settings → Apps → Pandora Spec → Permissions</item>
        <item>Enable “Nearby devices” and “Bluetooth”</item>
    </string-array>
    <string-array name="deviceselect_fix_item_ios">
        <item>Settings → Pandora Spec → Bluetooth → enable</item>
    </string-array>
    <string name="deviceselect_common_btn_open_settings">Open settings</string>
    <string name="deviceselect_common_btn_cancel">Cancel</string>
    <string name="deviceselect_common_btn_retry">Retry</string>

    <!-- Adapter off -->
    <string name="deviceselect_adapter_title">Bluetooth is off</string>
    <string name="deviceselect_adapter_subtitle">Turn on Bluetooth to find the alarm unit.</string>
    <string name="deviceselect_common_btn_open_bluetooth">Open Bluetooth settings</string>

    <!-- Location services off (BLE scan on Android < 12) -->
    <string name="deviceselect_location_title">Location is off</string>
    <string name="deviceselect_location_subtitle">On this Android version, Bluetooth scanning requires location services to be on.</string>
    <string name="deviceselect_common_btn_open_location">Open location settings</string>

    <!-- Scanning -->
    <string name="deviceselect_scanning_title">Searching for devices…</string>
    <string name="deviceselect_scanning_subtitle_ble">Keep your Pandora device nearby. Bluetooth devices will appear in the list automatically.</string>
    <string name="deviceselect_scanning_subtitle_usb">Connect your Pandora device with a cable. USB devices will appear in the list automatically.</string>
    <string name="deviceselect_scanning_subtitle_both">Keep your Pandora device nearby. Bluetooth and USB devices will appear in the list automatically.</string>

    <!-- Empty -->
    <string name="deviceselect_empty_title">No devices found</string>
    <string name="deviceselect_empty_subtitle">The search continues. Make sure the device is ready to connect.</string>
    <!-- Подсказки «пусто» — по поддерживаемым транспортам -->
    <string-array name="deviceselect_empty_item_ble">
        <item>Make sure the device is powered on</item>
        <item>Bring the unit closer — within 1–2 meters</item>
        <item>Check that Bluetooth is on</item>
    </string-array>
    <string-array name="deviceselect_empty_item_usb">
        <item>Check that the cable is connected to the device and the computer</item>
        <item>Try another USB port or cable</item>
        <item>Make sure the module is detected by the system</item>
    </string-array>
    <string-array name="deviceselect_empty_item_both">
        <item>Make sure the device is powered on and the cable is connected</item>
        <item>For Bluetooth, bring the unit closer — within 1–2 meters</item>
        <item>Check that Bluetooth is on or the USB module is detected</item>
    </string-array>
    <string name="deviceselect_scan_loading_searching">Searching…</string>

