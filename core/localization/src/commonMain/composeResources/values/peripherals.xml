    <string name="peripherals_instruction_item_bt760_1">Hold the A button for 6 seconds (until the 6th flash of the LED 1).</string>
    <string name="peripherals_instruction_item_btr_1">Connect the wire №1 to the ground(-)</string>
    <string name="peripherals_instruction_item_btr_2">Connect wires №3 and №4 and apply +12V to them.</string>
    <string name="peripherals_instruction_item_btr_3">Disconnect and insulate the wire №3 after successful pairing.</string>
    <string name="peripherals_instruction_title_di04">DI-04</string>
    <string name="peripherals_instruction_item_di04_1">Connect the wire №1 to the ground (-), and then Connect the wire №2 to +12V.</string>
    <string name="peripherals_instruction_item_di04_2">Press and hold the Button A for 6 seconds (until the 6th flash of the LED 1).</string>
    <string name="peripherals_instruction_title_bt01">BT-01</string>
    <string name="peripherals_instruction_item_bt01_1">Connect the wire №5 to the ground (-)</string>
    <string name="peripherals_instruction_item_bt01_2">Connect wires №1 and №9 and apply +12V to them.</string>
    <string name="peripherals_instruction_item_bt01_3">Disconnect and insulate the wire №9 after successful pairing.</string>
    <string name="peripherals_instruction_title_d030">D030 key fob</string>
    <string name="peripherals_instruction_item_d030_1">Turn on the remote control.</string>
    <string name="peripherals_instruction_item_d030_2">Press and hold 3 main buttons for 1 second (until the 1st flash of the LED 1).</string>
    <string name="peripherals_instruction_title_watch2">Pandora Watch 2</string>
    <string name="peripherals_instruction_item_watch2_1">Turn on the watch.</string>
    <string name="peripherals_instruction_item_watch2_2">Press the button C to enter the main menu. Select the "Settings" item using the buttons B and C and press the button D to enter the menu. Select the "Bluetooth" item using the buttons B and C and press the button D to enter the menu.</string>
    <string name="peripherals_instruction_item_watch2_3">Make sure that Bluetooth is enabled (turn it on using the button D if required). Select the "Vehicle" item using the buttons B and C and press the button D to enter the menu.</string>
    <string name="peripherals_instruction_item_watch2_4">If the watch has been previously paired, Select the "Delete" item and confirm the action using the button D .</string>
    <string name="peripherals_instruction_item_watch2_5">Select the "Connect" item and press the button D to confirm the action (the main unit must still be in pairing mode).</string>
    <string name="peripherals_instruction_title_band">Pandora Band</string>
    <string name="peripherals_instruction_item_band_1">Turn on the Pandora Band.</string>
    <string name="peripherals_instruction_item_band_2">Press and hold main button A for 6 seconds.</string>
    <string name="peripherals_instruction_title_nav035">NAV-035BT</string>
    <string name="peripherals_instruction_item_nav035_1">Connect the wire №2 to the ground (-), and then Connect the wire №1 to +12V.</string>
    <string name="peripherals_instruction_title_nav09">NAV-09</string>
    <string name="peripherals_instruction_item_nav09_1">Connect the device to a power supply.</string>
    <string name="peripherals_instruction_item_nav09_2">Enter the service PIN-code using the A button to put the Pandora Eye Pro to programming mode.</string>
    <string name="peripherals_instruction_item_nav09_3">Enter the programming level №1 of the Pandora Eye Pro.</string>
    <string name="peripherals_instruction_title_nav10">NAV-X</string>
    <string name="peripherals_instruction_item_nav10_1">Connect the device to a power supply.</string>
    <string name="peripherals_instruction_item_nav10_2">Enter the service PIN-code using the A button to put the Nav X to programming mode.</string>
    <string name="peripherals_instruction_item_nav10_3">Enter the programming level №1 of the NAV X.</string>
    <string name="peripherals_instruction_item_rfm_1">Connect the device to a power supply.</string>
    <string name="peripherals_instruction_item_rfm_2">Hold the A button for 6 seconds (until the 6th sound signal).</string>
    <string name="peripherals_instruction_title_rhm">RHM-03BT</string>
    <string name="peripherals_instruction_item_rhm_1">Connect the wires №4 and №5 and connect them both to the ground (-).</string>
    <string name="peripherals_instruction_item_rhm_2">Connect the wire №7 to +12V.</string>
    <string name="peripherals_instruction_title_ps331">PS-331BT siren</string>
    <string name="peripherals_instruction_item_ps331_1">Connect the wires №2 and №4 and connect them both to the ground (-).</string>
    <string name="peripherals_instruction_item_ps331_2">Connect the wire №1 to +12V.</string>
    <string name="peripherals_instruction_title_ps332">PS-332BT siren</string>
    <string name="peripherals_instruction_item_ps332_1">Put a magnet on the selected zone. Connect the wire №2 to ground and then Connect the wire №1 to +12V.</string>
    <string name="peripherals_instruction_item_dms_1">Insert a battery in the sensor</string>
    <string name="peripherals_instruction_item_hood_1">The programming loop must be uncut for pairing. Restore the wire if necessary.</string>
    <string name="peripherals_instruction_item_hood_2">Connect the wire 2 to ground</string>
    <string name="peripherals_instruction_item_hood_3">Connect the wire 1 to constant +12V power supply</string>
    <string name="peripherals_instruction_item_hood_4">Disconnect/Cut the programming loop after successful pairing</string>
    <string name="peripherals_instruction_item_vs_1">Connect the wire 2 to ground</string>
    <string name="peripherals_instruction_item_vs_2">Connect the wire 1 to constant +12V power supply</string>
    <string name="peripherals_instruction_item_vs_3">Press and hold the Button A for 6 seconds (until the 6th flash of the LED).</string>
    <string name="peripherals_instruction_item_nfc_1">Apply power to the NFC reader and wait for a single siren beep.</string>
    <string name="peripherals_instruction_item_fuel_1">If the sensor has not been used before (out of the box), it is necessary to turn off the transport mode, to do this: close and hold the tube and the condenser rod, lean the magnet against the reed switch of the fuel sensor, eliminate the short circuit. The same procedure is necessary if you want to attach the sensor to another alarm.</string>
    <string name="peripherals_instruction_item_fuel_2">If you need to pair a working sensor with a new alarm, you need to use magnet to enter a special sequence. The sequence is entered as follows. When the magnet is brought in, the red LED indicator of the reed switch operation lights up. Then, after a random time in the range from 1 to 11 s, the green indicator for 1 s. While it glows, you need to remove the magnet to open the reed switch. If the magnet was removed in time, the sensor goes into a state of readiness to enter the next sequence code. Then the action is repeated 2 more times (the length of the sequence is 3). If the sequence code is entered incorrectly, a long red flash is indicated. If the code is entered correctly, no indication is made. After the successful entry of the entire sequence, an indication of a successful transition to the pairing mode (2x green flash) is performed.</string>
    <string name="peripherals_instruction_item_fuel_3">Sensor stays in pairing mode for 2 minutes</string>
